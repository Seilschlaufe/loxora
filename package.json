{
  "name": "lexora",
  "version": "1.0.0",
  "description": "Lexora: контекстное чтение и личный словарь",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "bash supabase/test.sh",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "test:ai": "vitest run tests/live-ai.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seilschlaufe/loxora.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Seilschlaufe/loxora/issues"
  },
  "homepage": "https://github.com/Seilschlaufe/loxora#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "idb": "^8.0.4",
    "next": "^16.4.5",
    "openai": "^7.53.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
